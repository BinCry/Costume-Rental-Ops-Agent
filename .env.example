APP_ENV=development
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# Dedicated PostgreSQL database using the pgvector image.
AI_DATABASE_URL=postgresql://postgres:password@localhost:15433/postgres?sslmode=disable

# Directory containing the Markdown knowledge base. Relative paths resolve from the project root.
KNOWLEDGE_BASE_ROOT=knowledge-base
KNOWLEDGE_CORPUS_ID=costume-rental-operations
KNOWLEDGE_MODEL_ID=intfloat/multilingual-e5-small
KNOWLEDGE_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
KNOWLEDGE_MODEL_CACHE_DIR=.cache/huggingface
KNOWLEDGE_MIN_SCORE=0.72

# OpenAI-compatible providers. Groq is primary; Gemini is fallback.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=25
LLM_RETRY_COUNT=1

# Required by every /api/v1/knowledge/* request and must match the Studio API value.
# Never expose this secret to browsers; keep the Python service private.
AI_INTERNAL_API_KEY=replace-with-a-random-secret-at-least-32-characters
# Private Studio API origin used only by the fixed agent-tool client.
STUDIO_API_URL=http://costume-api:3000
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_MAX_STEPS_PER_TURN=6
# Browser origins are useful only for local API docs/testing; production traffic goes through Studio API.
AI_WEB_ALLOWED_ORIGINS=http://localhost:5173
